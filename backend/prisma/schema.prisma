// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String @id @default(uuid())
  username  String @unique
  password  String 
  profilePicture  String? //(was thinking string to store file path?)
  createdAt DateTime @default(now())
  loginAttempts Int @default(0) // Track failed login attempts
  lockedUntil   DateTime? // Account lockout timestamp

  /// Votes received on this user's flipbooks across completed games.
  totalVotesReceived Int @default(0)
  /// Times this user finished 1st (ties count as 1st).
  wins                 Int @default(0)
  /// Completed games this user participated in.
  gamesPlayed          Int @default(0)

  // Relations
  hostedLobbies Lobby[]     @relation("LobbyHost")
  lobbies       Lobby[]     @relation("LobbyPlayers")
  flipbooks     Flipbook[]
  wonRounds     Round[]     @relation("RoundWinner")
  drawings      Drawing[]
  guesses       Guess[]
  refreshTokens RefreshToken[]
  savedFlipbooks SavedFlipbook[]
  roundVotesCast RoundVote[] @relation("RoundVoteVoter")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime? // For token invalidation
  
  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
}

model Lobby {
  id        String     @id @default(uuid())
  roomCode  String     @unique
  state     LobbyState @default(WAITING)
  createdAt DateTime   @default(now())

  // Relations
  host        User       @relation("LobbyHost", fields: [hostId], references: [id], onDelete: Cascade)
  hostId      String
  players     User[]     @relation("LobbyPlayers")
  rounds      Round[]
}

model Round{
  id          String     @id @default(uuid())
  number      Int
  createdAt   DateTime   @default(now())
  /// 0 = collect initial prompts on own flipbook; 1..N-1 = draw/guess chain; N = host recap; N+1 = favorite voting.
  chainWave   Int        @default(0)
  /// Server-authoritative end time for the current phase (used by clients for countdown).
  phaseDeadline DateTime?
  /// Populated when favorite voting finishes (rankings, vote counts).
  votingResults Json?

  // Relations
  lobby       Lobby      @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  lobbyId     String
  flipbooks   Flipbook[]
  winner      User?      @relation("RoundWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  winnerId    String?
  roundVotes  RoundVote[]
}

model Flipbook {
  id          String        @id @default(uuid())
  prompt      String        // Starting word/phrase for the flipbook
  votes       Int           @default(0)
  state       FlipbookState @default(DRAWING)
  createdAt   DateTime      @default(now())

  // Relations
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  round       Round         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId     String
  drawings    Drawing[]
  guesses     Guess[]
  roundVotes  RoundVote[]
}

/// One favorite vote per player per round (not your own flipbook).
model RoundVote {
  id         String   @id @default(uuid())
  roundId    String
  voterId    String
  flipbookId String
  createdAt  DateTime @default(now())

  round    Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  voter    User     @relation("RoundVoteVoter", fields: [voterId], references: [id], onDelete: Cascade)
  flipbook Flipbook @relation(fields: [flipbookId], references: [id], onDelete: Cascade)

  @@unique([roundId, voterId])
  @@index([roundId])
}

model Drawing {
  id            String              @id @default(uuid())
  /// Full vector payload when small; null when stored in blob storage (see storageKey).
  drawingData   String?             @db.Text
  storageKind   DrawingStorageKind  @default(INLINE)
  /// Opaque relative key (e.g. game/{flipbookId}/{drawingId}.json). Swap backing store (S3, etc.) without schema changes.
  storageKey    String?             @unique
  byteLength    Int?
  order         Int // Position in the flipbook sequence
  createdAt     DateTime            @default(now())

  // Relations
  flipbook   Flipbook @relation(fields: [flipbookId], references: [id], onDelete: Cascade)
  flipbookId String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
}

/// User-owned copy of a completed flipbook (opt-in at end of game). Independent of lobby lifecycle.
model SavedFlipbook {
  id               String   @id @default(uuid())
  ownerId          String
  sourceFlipbookId String?
  sourceRoundId    String?
  prompt           String
  title            String?
  createdAt        DateTime @default(now())

  owner    User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  drawings SavedDrawing[]
  guesses  SavedGuess[]

  @@unique([ownerId, sourceFlipbookId])
  @@index([ownerId])
}

model SavedDrawing {
  id              String             @id @default(uuid())
  savedFlipbookId String
  order           Int
  authorId        String
  authorUsername  String
  drawingData     String?            @db.Text
  storageKind     DrawingStorageKind @default(INLINE)
  storageKey      String?            @unique
  byteLength      Int?

  savedFlipbook SavedFlipbook @relation(fields: [savedFlipbookId], references: [id], onDelete: Cascade)

  @@index([savedFlipbookId])
}

model SavedGuess {
  id              String   @id @default(uuid())
  savedFlipbookId String
  order           Int
  text            String
  authorId        String
  authorUsername  String

  savedFlipbook SavedFlipbook @relation(fields: [savedFlipbookId], references: [id], onDelete: Cascade)

  @@index([savedFlipbookId])
}

model Guess {
  id          String   @id @default(uuid())
  text        String
  order       Int      // Position in the flipbook sequence
  createdAt   DateTime @default(now())

  // Relations
  flipbook    Flipbook @relation(fields: [flipbookId], references: [id], onDelete: Cascade)
  flipbookId  String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
}

enum LobbyState {
  WAITING
  STARTING
  IN_PROGRESS
  FINISHED
}

enum FlipbookState {
  DRAWING
  GUESSING
  VOTING
}

enum DrawingStorageKind {
  INLINE
  LOCAL_FILE
}

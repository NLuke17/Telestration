# Production image for AWS ECS.
# Default Fargate task uses ARM64 (Apple Silicon: docker build ... works as-is).
# For linux/amd64-only Fargate, set fargate_cpu_architecture = "X86_64" in Terraform and build with:
#   docker buildx build --platform linux/amd64 -f Dockerfile.prod -t <ecr>:latest --push backend/
FROM node:22-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY package*.json ./
COPY prisma ./prisma
RUN npx prisma generate

COPY . .

EXPOSE 8000

CMD ["sh", "-c", "npx prisma migrate deploy && exec npx tsx src/server.ts"]
